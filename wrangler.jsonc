{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kennebc-county-jail-monoply",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "NIGHT_SHIFT_MAP",
        "class_name": "NightShiftMap"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-game-rooms",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    },
    {
      "tag": "v2-shared-night-shift-map",
      "new_sqlite_classes": [
        "NightShiftMap"
      ]
    }
  ]
}
